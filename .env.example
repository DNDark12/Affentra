APP_NAME=Affentra
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TRUSTED_HOST=localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=affentra
DB_USERNAME=affentra
DB_PASSWORD=secret

SESSION_DRIVER=database
SESSION_LIFETIME=1440
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
CACHE_TTL_HOURS=5
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=predis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
VITE_DEV_SERVER_URL=http://[::1]:5173
SECURITY_CSP_DEV_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/callback"

# Shopee Integration (full test mode)
INTEGRATIONS_ENABLE_COOKIE_METHOD=true
SHOPEE_AFFILIATE_API_URL=https://open-api.affiliate.shopee.vn/graphql
SHOPEE_SYNC_MODE=scheduled
SHOPEE_SYNC_INTERVAL=60
SHOPEE_BACKFILL_DAYS=90
SHOPEE_HARD_LIMIT_DAYS=90
SHOPEE_OFFER_CACHE_TTL=30
SHOPEE_CAMPAIGN_SYNC_AT=09:05
DASHBOARD_CACHE_TTL_SECONDS=120

# Sync Pipeline
SYNC_INTERVAL_MINUTES=60
SYNC_LOCK_TTL=900
SYNC_UPSERT_CHUNK=500
SYNC_AGGREGATE_UNIQUE_FOR=900
SYNC_AGGREGATE_LOCK_RELEASE_AFTER=15
SYNC_AGGREGATE_LOCK_EXPIRE_AFTER=300

# Rate Limiting
RATE_LIMIT_REDIRECT=60
RATE_LIMIT_LOGIN=5
RATE_LIMIT_IMPORT=10

# Retention
RETENTION_CLICKS_DAYS=90

# Security hardening
SECURITY_CSP_ENABLED=true
SECURITY_CSP_REPORT_ONLY=false
SECURITY_CSP_REPORT_URI=
SECURITY_X_FRAME_OPTIONS=DENY
SECURITY_X_CONTENT_TYPE_OPTIONS=nosniff
SECURITY_REFERRER_POLICY=strict-origin-when-cross-origin
SECURITY_PERMISSIONS_POLICY="camera=(), microphone=(), geolocation=()"
SECURITY_X_PERMITTED_CROSS_DOMAIN_POLICIES=none
SECURITY_HSTS_ENABLED=false
SECURITY_HSTS_MAX_AGE=31536000
SECURITY_HSTS_INCLUDE_SUBDOMAINS=true
SECURITY_HSTS_PRELOAD=false

# Tracking presets
TRACKING_PRESET_TOP_MIN_ORDERS=1
TRACKING_PRESET_TOP_MIN_COMMISSION=50000
TRACKING_PRESET_LOW_MIN_CLICKS=100
TRACKING_PRESET_LOW_MAX_ORDER_RATE=0.01

# Alerts
ALERT_EVALUATION_INTERVAL_MINUTES=15
# DEPRECATED (do not use in runtime): alert telegram is now per-user config in DB
# ALERT_TELEGRAM_BOT_TOKEN=
# ALERT_TELEGRAM_CHAT_ID=

# Seeder defaults
SEED_ADMIN_EMAIL=admin@affentra.com
SEED_ADMIN_PASSWORD=password
